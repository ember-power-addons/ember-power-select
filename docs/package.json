{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "Docs app for ember-power-select addon",
  "repository": "",
  "license": "MIT",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "test": "vite build --mode development && testem ci --port 0"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^8.0.8",
    "@ember/app-tsconfig": "^2.1.0",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.7.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.27",
    "@embroider/config-meta-loader": "^1.0.1",
    "@embroider/core": "^4.6.10",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.4",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.15",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.2.1",
    "@glint/ember-tsc": "^1.11.6",
    "@glint/template": "^1.9.0",
    "@glint/tsserver-plugin": "^2.7.12",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.14",
    "@types/rsvp": "^4.0.9",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^10.0.6",
    "decorator-transforms": "^2.4.0",
    "ember-basic-dropdown": "^9.0.1",
    "ember-cli": "~7.3.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-concurrency": "^5.3.0",
    "ember-inflector": "^7.0.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-power-select": "workspace:*",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.1",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^7.9.4",
    "ember-truth-helpers": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.9.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.13.0",
    "memory-scroll": "^2.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "rsvp": "^4.8.5",
    "sass-embedded": "^1.106.1",
    "shiki": "^4.5.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "testem": "^3.21.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
